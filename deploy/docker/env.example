# Copy this file to .env.validation at the repository root and adjust only non-secret values.
# Docker Compose reads it through: docker compose --env-file .env.validation ...
# NEVER place plaintext passwords, bootstrap codes, or model credentials in this file or in Git.
# Store local secret material in deploy/docker/secrets/ (ignored by Git); the Runner reads it
# through file: secret references mounted read-only at /run/secrets.

NODE_ENV=production
UNSPOOL_RUNNER_PORT=8443
UNSPOOL_DATA_DIR=/var/lib/unspool
UNSPOOL_MODEL_PROVIDER=faux
UNSPOOL_BETA_ENABLED=false
UNSPOOL_MODEL_GATEWAY_URL=http://model-gateway:8080
UNSPOOL_FAUX_MODEL_URL=http://fake-model:8080
UNSPOOL_FAKE_EXTERNAL_URL=http://fake-external:8080
UNSPOOL_BOOTSTRAP_SECRET_REF=file:/run/secrets/unspool_bootstrap_code
UNSPOOL_SESSION_SECRET_REF=file:/run/secrets/unspool_session_key
